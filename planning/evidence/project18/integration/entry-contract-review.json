  "native": {
    "mismatches": [],
    "confirmed": [
      "createNativeContextHooks receives the actual DocumentService; prepared replacement owns model adoption and editor preservation.",
      "collectNativeSourceChanges receives state plus Documents and captures immutable changed-source revisions.",
      "refreshNativeExplorerWorkspace receives state, Documents, nativeBuild and renderWorkspace, followed by mappings and {partial,signal}.",
      "The Explorer operation signal is passed by the protected proposal; native refresh checks client, workspace, document and model ownership before replacement."
    ],
