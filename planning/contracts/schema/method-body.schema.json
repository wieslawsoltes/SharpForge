{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "methodId": {
      "type": "string"
    },
    "encoding": {
      "enum": [
        "bytecode",
        "cil"
      ]
    },
    "offsetUnit": {
      "const": "instruction"
    },
    "locals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
      },
      "maxItems": 1000000
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "opcode": {
            "enum": [
              "nop",
              "constant",
              "load-local",
              "store-local",
              "load-argument",
              "store-argument",
              "local-address",
              "argument-address",
              "load-static",
              "store-static",
              "static-address",
              "load-field",
              "store-field",
              "field-address",
              "duplicate",
              "discard",
              "binary",
              "unary",
              "compare",
              "convert",
              "branch",
              "branch-if",
              "compare-branch",
              "switch",
              "leave",
              "call",
              "return",
              "new-object",
              "new-array",
              "new-delegate",
              "load-element",
              "store-element",
              "element-address",
              "length",
              "throw",
              "rethrow",
              "end-finally",
              "function-address",
              "box",
              "unbox",
              "cast",
              "is-instance",
              "check-finite",
              "size-of"
            ]
          },
          "operands": {
            "type": "array",
            "items": {},
            "maxItems": 1000000
          },
          "resultType": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
            },
            "maxItems": 1000000
          },
          "sourceEncoding": {
            "enum": [
              "bytecode",
              "cil"
            ]
          },
          "sourceOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "sourceOpcode": {
            "type": "string"
          },
          "outputTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
            },
            "maxItems": 1000000
          },
          "stackIn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
            },
            "maxItems": 1000000
          },
          "stackOut": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
            },
            "maxItems": 1000000
          },
          "successors": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "maxItems": 1000000
          }
        },
        "required": [
          "offset",
          "opcode",
          "operands",
          "resultType",
          "inputTypes",
          "sourceEncoding",
          "sourceOffset",
          "sourceOpcode",
          "outputTypes",
          "stackIn",
          "stackOut",
          "successors"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "exceptionRegions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "catch",
              "finally",
              "fault",
              "filter"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "handlerStart": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "handlerEnd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "catchType": {
            "type": [
              "string",
              "null"
            ]
          },
          "filterStart": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "start",
          "end",
          "handlerStart",
          "handlerEnd",
          "catchType",
          "filterStart"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "safepoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "kind": {
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "required": [
          "offset",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "typeState": {
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
      },
      "maxItems": 1000000
    },
    "returnType": {
      "type": "string",
      "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
    },
    "maxStack": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "localStorageTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1000000
    },
    "parameterStorageTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1000000
    },
    "returnStorageType": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "methodId",
    "encoding",
    "offsetUnit",
    "locals",
    "instructions",
    "exceptionRegions",
    "safepoints",
    "typeState",
    "parameters",
    "returnType",
    "maxStack",
    "localStorageTypes",
    "parameterStorageTypes",
    "returnStorageType"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "typeState": {
          "const": "unresolved"
        }
      }
    },
    {
      "properties": {
        "typeState": {
          "const": "resolved"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resultType": {
                "type": "string",
                "pattern": "^(i32|i64|nativeint|f32|f64|void|null|ref:.+|byref:.+|pointer:.+)$"
              }
            },
            "required": [
              "resultType"
            ]
          }
        }
      }
    }
  ]
}
