{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "engine": {
      "enum": [
        "source",
        "cil"
      ]
    },
    "state": {
      "type": "string"
    },
    "instructions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "frameId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "hostRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "methodId": {
            "type": [
              "integer",
              "string"
            ]
          },
          "pc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "localCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "argumentCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "stackCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "required": [
          "id",
          "methodId",
          "pc",
          "localCount",
          "argumentCount",
          "stackCount"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000000
    },
    "heap": {
      "type": "object",
      "properties": {
        "generationCounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "liveObjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "liveBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "generationCounter",
        "liveObjects",
        "liveBytes"
      ],
      "additionalProperties": false
    },
    "pendingFault": {
      "type": [
        "string",
        "null"
      ]
    },
    "fault": {
      "type": [
        "string",
        "null"
      ]
    },
    "output": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1000000
    }
  },
  "required": [
    "schemaVersion",
    "engine",
    "state",
    "instructions",
    "frameId",
    "hostRevision",
    "frames",
    "heap",
    "pendingFault",
    "fault",
    "output"
  ],
  "additionalProperties": false
}
