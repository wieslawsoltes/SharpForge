{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "One capability obligation evidence",
  "required": [
    "schemaVersion",
    "leafId",
    "capabilityId",
    "platform",
    "engine",
    "specRevision",
    "status",
    "commit",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "leafId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^SF-A\\d{2}-[TB]\\d+(?:\\.\\d+)?$"
        },
        {
          "type": "string",
          "pattern": "^SF-R\\d{3}-[TB]\\d{2}(?:\\.\\d+)?$"
        }
      ]
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "specRevision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "unsupported"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "unsupported"
          ]
        }
      },
      "required": [
        "reason"
      ]
    }
  ]
}
