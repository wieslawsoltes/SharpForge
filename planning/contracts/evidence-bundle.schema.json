{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clean committed execution evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "headCommit",
    "command",
    "summary",
    "obligations",
    "evidenceDigest",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "task": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^SF-A\\d{2}-[TB]\\d+(?:\\.\\d+)?$"
        },
        {
          "type": "string",
          "pattern": "^SF-R\\d{3}-[TB]\\d{2}(?:\\.\\d+)?$"
        }
      ]
    },
    "headCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "passed",
        "failed",
        "cancelled",
        "skipped",
        "todo",
        "exitCode",
        "complete"
      ],
      "properties": {
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "todo": {
          "type": "integer",
          "minimum": 0
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Command-emitted target proof bound to one TAP result",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "platform",
          "engine",
          "specRevision",
          "status",
          "testName"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "specRevision": {
            "type": "string",
            "minLength": 1
          },
          "testName": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "unsupported"
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "unsupported"
                ]
              }
            },
            "required": [
              "reason"
            ]
          }
        ]
      }
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "required": [
        "tests.tap",
        "stderr.log",
        "environment.json"
      ],
      "properties": {
        "tests.tap": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stderr.log": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment.json": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
