{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharpForge area test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "area",
    "nodeGlobs",
    "browserScripts",
    "requiredServices",
    "timeout",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "area": {
      "type": "string",
      "pattern": "^A[0-2][0-9]$"
    },
    "nodeGlobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "browserScripts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredServices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
