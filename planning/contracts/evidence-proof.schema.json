{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command-emitted target proof bound to one TAP result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "platform",
    "engine",
    "specRevision",
    "status",
    "testName"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "specRevision": {
      "type": "string",
      "minLength": 1
    },
    "testName": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "unsupported"
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "unsupported"
          ]
        }
      },
      "required": [
        "reason"
      ]
    }
  ]
}
