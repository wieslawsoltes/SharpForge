{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharpforge.dev/contracts/backlog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repository",
    "defaultBranch",
    "updatedAt",
    "issues"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "repository": {
      "type": "string"
    },
    "defaultBranch": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "title",
          "body",
          "state",
          "area",
          "kind",
          "parent",
          "dependencies",
          "contracts",
          "labels",
          "project",
          "pullRequests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SF-(A[0-9]{2}|R[0-9]{3})-[ETB][0-9]{2}(\\.[0-9]+)?$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "state": {
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          },
          "area": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "Epic",
              "Task",
              "Sub-task",
              "Bug"
            ]
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project": {
            "type": "object"
          },
          "pullRequests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "number",
                "merged",
                "mergedAt",
                "mergeCommit",
                "head",
                "baseRefName"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer"
                },
                "merged": {
                  "type": "boolean"
                },
                "mergedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mergeCommit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "head": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "baseRefName": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
