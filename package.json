{
  "name": "sharpforge",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Modular JavaScript C# subset compiler with ECMA-335 IL/PE output, managed runtime, debugger and browser IDE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "start": "node scripts/serve.js",
    "bench": "node scripts/benchmark.js",
    "check": "node scripts/check.js",
    "check:structure": "node scripts/quality/check-structure.js",
    "test:browser": "python tests/browser_test.py",
    "cli": "node apps/cli/main.js",
    "test:protocol": "node --test tests/protocol.test.js",
    "standalone": "npm run build && node scripts/standalone.js",
    "test:standalone": "python tests/standalone_test.py",
    "bench:il": "node scripts/benchmark-il.js",
    "test:dotnet": "node scripts/validate-dotnet.js",
    "test:clr-wasm": "node scripts/validate-clr-wasm.js",
    "test:packages": "node scripts/verify-packages.js",
    "test:browser:managed": "python tests/browser_managed_test.py",
    "examples:managed": "node scripts/build-managed-examples.js",
    "test:browser:workspace": "python tests/browser_workspace_test.py",
    "lsp": "node packages/protocol/bin/sharpforge-lsp.js",
    "dap": "node packages/protocol/bin/sharpforge-dap.js",
    "test:browser:release": "python tests/browser_release06_test.py",
    "test:browser:release05": "python tests/browser_release05_test.py",
    "bench:release": "node scripts/benchmark-release06.js",
    "msbuild": "node packages/msbuild/bin/sharpforge-msbuild.js",
    "test:msbuild": "node --test tests/msbuild-*.test.js tests/project-msbuild-evaluation.test.js",
    "test:msbuild:native": "node scripts/validate-msbuild.js",
    "test:browser:msbuild": "python tests/browser_msbuild_test.py",
    "test:browser:explorer": "python tests/browser_release08_test.py",
    "test:browser:native-explorer": "python tests/browser_native_explorer_test.py",
    "test:browser:debugger": "python tests/browser_release09_test.py",
    "test:browser:advanced": "python tests/browser_release10_test.py",
    "examples:release10": "node scripts/build-release10-examples.js",
    "test:browser:templates": "python tests/browser_release11_test.py",
    "test:templates": "node --test tests/templates-archive.test.js tests/workspace-io.test.js",
    "examples:templates": "node scripts/build-template-examples.js",
    "test:browser:designer": "python tests/browser_release12_test.py",
    "test:designer": "node --test tests/designer.test.js tests/designer-examples.test.js tests/edit-continue.test.js tests/styles-templates.test.js",
    "examples:designer": "node scripts/build-designer-examples.js",
    "test:browser:sync": "python tests/browser_release13_test.py",
    "test:release13": "node --test tests/bcl13.test.js tests/designer-sync13.test.js tests/animation13.test.js tests/examples13.test.js",
    "examples:release13": "node scripts/build-release13-examples.js",
    "test:release14": "node --test tests/*14.test.js",
    "test:browser:runtime": "python tests/browser_release14_test.py",
    "examples:release14": "node scripts/build-release14-examples.js",
    "bench:runtime": "node scripts/benchmark-release14.js",
    "bench:compute": "node scripts/benchmark-compute14.js"
  },
  "engines": {
    "node": ">=22"
  }
}
