<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Subject" AutomationProperties.Name="Fixed and weighted grid columns">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="80" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="2*" />
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <TextBlock x:Name="Heading" Grid.ColumnSpan="3" Text="Three column layout" Margin="8" />
  <Border x:Name="FixedColumn" Grid.Row="1" Background="LightGray" Margin="4">
    <TextBlock Text="Fixed" />
  </Border>
  <Border x:Name="SingleWeightColumn" Grid.Row="1" Grid.Column="1" Background="LightBlue" Margin="4">
    <TextBlock Text="One share" />
  </Border>
  <Border x:Name="DoubleWeightColumn" Grid.Row="1" Grid.Column="2" Background="LightGreen" Margin="4">
    <TextBlock Text="Two shares" />
  </Border>
</Grid>
