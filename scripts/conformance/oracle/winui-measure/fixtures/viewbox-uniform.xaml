<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Name="Subject" AutomationProperties.Name="Uniformly scaled content"
         Width="240" Height="120" Stretch="Uniform">
  <Grid x:Name="UnscaledContent" Width="80" Height="40" Background="LightBlue">
    <TextBlock x:Name="Caption" Text="Scale" FontSize="12"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</Viewbox>
