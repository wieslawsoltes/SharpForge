+test('A00 readonly source carriers and CIL fields lower to existing typed load-static operations', () => {
+  const bodies = lowered('class P { static void Main() { Console.WriteLine(bool.TrueString); Console.WriteLine(bool.FalseString); } }');
+  for (const encoding of ['bytecode', 'cil']) {
+    const selected = bodies.filter(body => body.encoding === encoding);
+    for (const body of selected) { validate(schema, body); validateBody(body, {requireExecutable: true}); }
+    const fields = selected.flatMap(body => body.instructions)
+      .filter(instruction => instruction.opcode === 'load-static' && instruction.operands[0].owner === 'System.Boolean');
+    assert.deepEqual([...new Set(fields.map(instruction => instruction.operands[0].name))].sort(), ['FalseString', 'TrueString']);
+    for (const instruction of fields) {
+      const field = instruction.operands[0];
+      assert.equal(field.type, 'ref:System.String');
+      assert.equal(field.storageType, 'System.String');
+      assert.deepEqual(instruction.inputTypes, []);
+      assert.deepEqual(instruction.outputTypes, ['ref:System.String']);
+      assert.deepEqual(instruction.stackOut, [...instruction.stackIn, 'ref:System.String']);
+      assert.equal(instruction.sourceOpcode, encoding === 'bytecode' ? 'CONST' : 'ldsfld');
+      if (encoding === 'bytecode') assert.equal(field.id, 'field:' + JSON.stringify([field.owner, field.name]));
+    }
+  }
+});
+
+test('A00 source readonly field lowering rejects malformed, alias and non-string field identities without getters', () => {
+  const marker = {readonlyField: {owner: 'System.Boolean', name: 'TrueString'}};
+  const check = value => {
+    const image = imageWith([[Op.CONST, 0, 0], [Op.RET, 0, 0]]);
+    image.methods[0].returnType = 'string'; image.constants = [value];
+    return methodBody(image.methods[0], 'bytecode', {image});
+  };
+  const valid = check(marker);
+  validate(schema, valid); validateBody(valid, {requireExecutable: true});
+  const cases = [{readonlyField: null}, {...marker, extra: 1},
+    {readonlyField: {...marker.readonlyField, extra: 1}},
+    {readonlyField: {...marker.readonlyField, owner: 'Boolean'}},
+    {readonlyField: {...marker.readonlyField, name: 'Missing'}},
+    {readonlyField: {owner: 'System.Diagnostics.Stopwatch', name: 'Frequency'}},
+    Object.create(marker), Object.assign(() => {}, marker)];
+  for (const value of cases) assert.throws(() => check(value), {code: 'SCHEMA_INVALID'});
+  let reads = 0;
+  const accessor = Object.defineProperty({}, 'readonlyField', {enumerable: true, get() { reads++; return marker.readonlyField; }});
+  const nested = {readonlyField: {name: 'TrueString'}};
+  Object.defineProperty(nested.readonlyField, 'owner', {enumerable: true, get() { reads++; return 'System.Boolean'; }});
+  for (const value of [accessor, nested]) assert.throws(() => check(value), {code: 'SCHEMA_INVALID'});
+  assert.equal(reads, 0);
+  const numericHint = imageWith([[Op.CONST, 0, 1], [Op.RET, 0, 0]]);
+  numericHint.methods[0].returnType = 'string'; numericHint.constants = [marker];
+  assert.throws(() => methodBody(numericHint.methods[0], 'bytecode', {image: numericHint}), {code: 'SCHEMA_INVALID'});
+  assert.throws(() => check({unknown: true}), {code: 'SCHEMA_UNSUPPORTED'});
+});
