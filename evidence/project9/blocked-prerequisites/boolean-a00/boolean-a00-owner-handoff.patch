+  const values = [null, true, false, 0, -0, 1.5, '', 'text'];
+  const budget = 2 + values.length * 2;
+  for (const contract of [before, after]) {
+    assert.equal(validate(contract, values, {maxNodes: budget}), values);
+    assert.throws(() => validate(contract, values, {maxNodes: budget - 1}), {code: 'SCHEMA_LIMIT'});
+    for (const value of values) {
+      assert.equal(validate(contract.items, value, {maxNodes: 2}), value);
+      assert.throws(() => validate(contract.items, value, {maxNodes: 1}), {code: 'SCHEMA_LIMIT'});
+    }
+  }
+});
