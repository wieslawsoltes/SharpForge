+test('A00 serialized readonly string fields pass structural validation before deserialization', () => {
+  const compiled = compileToIL('class P { static void Main() { Console.WriteLine(bool.TrueString); Console.WriteLine(bool.FalseString); } }');
+  assert(compiled.success, JSON.stringify(compiled.diagnostics));
+  const document = JSON.parse(serializeImage(compiled.image));
+  validate(schema('bytecode-image.v2'), document);
+  const image = deserializeImage(JSON.stringify(document));
+  assert.deepEqual(verifyImage(image), []);
+  assert.deepEqual(image.constants.filter(value => value?.readonlyField).map(value => value.readonlyField.name).sort(),
+    ['FalseString', 'TrueString']);
+});
+
+test('A00 readonly string structural shape is closed and excluded from static defaults', () => {
+  const contract = schema('bytecode-image.v2'), item = contract.properties.constants.items;
+  const marker = {readonlyField: {owner: 'System.Boolean', name: 'TrueString'}};
+  validate(item, marker);
+  const cases = [{}, {readonlyField: null}, {readonlyField: []}, {readonlyField: {}},
+    {readonlyField: {owner: 'System.Boolean'}}, {readonlyField: {...marker.readonlyField, extra: true}},
+    {...marker, extra: true}, {readonlyField: {...marker.readonlyField, owner: ''}},
+    {readonlyField: {...marker.readonlyField, name: 1}}, {readonlyField: {...marker.readonlyField, name: ''}},
+    [], {numericType: 'long', value: '1'}];
+  for (const value of cases) assert.throws(() => validate(item, value), {code: 'SCHEMA_INVALID'});
+  assert.throws(() => validate(contract.properties.statics.items,
+    {name: 'P.Value', type: 'string', value: marker}), {code: 'SCHEMA_INVALID'});
+  // Registry identity, NUL exclusion and UTF-16 limits belong to semantic validation.
+  validate(item, {readonlyField: {owner: 'Unknown.Type', name: 'Text'}});
+});
+
+test('A00 structurally valid field strings retain semantic NUL and UTF-16 length rejection', () => {
+  const compiled = compileToIL('class P { static void Main() { Console.WriteLine(bool.TrueString); } }');
+  assert(compiled.success, JSON.stringify(compiled.diagnostics));
+  const document = JSON.parse(serializeImage(compiled.image));
+  const index = document.constants.findIndex(value => value?.readonlyField);
+  assert(index >= 0);
+  const marker = document.constants[index].readonlyField;
+  for (const field of [{...marker, owner: 'A\0B'}, {...marker, name: 'A\0B'},
+    {...marker, owner: 'x'.repeat(1025)}, {...marker, name: 'x'.repeat(513)},
+    {...marker, owner: '\u{1f600}'.repeat(513)}, {...marker, name: '\u{1f600}'.repeat(257)}]) {
+    const candidate = structuredClone(document);
+    candidate.constants[index] = {readonlyField: field};
+    validate(schema('bytecode-image.v2'), candidate);
+    assert(verifyImage(deserializeImage(JSON.stringify(candidate))).some(error => error.includes('Invalid scalar constant')));
+  }
+});
+
+test('A00 primitive constants retain the exact pre-carrier validation node budget', () => {
+  const before = {type: 'array', items: {type: ['number', 'boolean', 'string', 'null']}};
+  const after = schema('bytecode-image.v2').properties.constants;
+  const values = [null, true, false, 0, -0, 1.5, '', 'text'];
+  const budget = 2 + values.length * 2;
+  for (const contract of [before, after]) {
+    assert.equal(validate(contract, values, {maxNodes: budget}), values);
+    assert.throws(() => validate(contract, values, {maxNodes: budget - 1}), {code: 'SCHEMA_LIMIT'});
+    for (const value of values) {
+      assert.equal(validate(contract.items, value, {maxNodes: 2}), value);
+      assert.throws(() => validate(contract.items, value, {maxNodes: 1}), {code: 'SCHEMA_LIMIT'});
+    }
+  }
+});
