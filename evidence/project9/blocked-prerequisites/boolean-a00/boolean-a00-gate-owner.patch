+test('closed readonly-field carrier is additive through uniform constant items without a version bump', () => {
+  const path = 'planning/contracts/schema/bytecode-image.v2.schema.json';
+  const after = JSON.parse(readFileSync(new URL('../schema/bytecode-image.v2.schema.json', import.meta.url), 'utf8'));
+  assert(after.properties.constants.items.type.includes('object'));
+  const before = structuredClone(after);
+  before.properties.constants.items = {type: ['number', 'boolean', 'string', 'null']};
+  const result = checkContractChange({before: {[path]: before}, after: {[path]: after},
+    beforeVersions: versions, afterVersions: versions});
+  assert.deepEqual(result.errors, []);
+  assert.deepEqual(result.changes, [{path, component: 'bytecode', breaking: false}]);
+});
+
+test('closed-object carrier proof rejects unrelated alternatives and narrowing constraints', () => {
+  const path = 'planning/contracts/schema/bytecode-image.v2.schema.json';
+  const primitives = {type: ['number', 'boolean', 'string', 'null']};
+  const carrier = JSON.parse(readFileSync(new URL('../schema/bytecode-image.v2.schema.json', import.meta.url), 'utf8'))
+    .properties.constants.items;
+  const mutate = change => { const value = structuredClone(carrier); change(value); return value; };
+  const cases = [
+    ['removed old primitive', primitives, {...carrier, type: ['number', 'boolean', 'string', 'object']}],
+    ['reordered types', primitives, {...carrier, type: ['object', ...primitives.type]}],
+    ['unrelated added primitive', primitives, {...carrier, type: [...primitives.type, 'integer', 'object']}],
+    ['array alternative', primitives, {...carrier, type: [...primitives.type, 'array']}],
+    ['duplicate type', primitives, {...carrier, type: [...primitives.type, 'object', 'object']}],
+    ['old object acceptance', {...primitives, type: [...primitives.type, 'object']}, carrier],
+    ['old primitive constraint', {...primitives, maxLength: 8}, {...carrier, maxLength: 8}],
+    ['new primitive constraint', primitives, {...carrier, minLength: 1}],
+    ['unknown validation keyword', primitives, {...carrier, minProperties: 1}],
+    ['reference scope', primitives, {...carrier, $id: 'https://example.test/carrier'}],
+    ['arbitrary object', primitives, {type: [...primitives.type, 'object']}],
+    ['open record', primitives, {...carrier, additionalProperties: true}],
+    ['missing closure', primitives, mutate(value => { delete value.additionalProperties; })],
+    ['missing required', primitives, mutate(value => { delete value.required; })],
+    ['unknown required key', primitives, {...carrier, required: ['missing']}],
+    ['duplicate required key', primitives, {...carrier, required: ['readonlyField', 'readonlyField']}],
+    ['nested open record', primitives, mutate(value => { value.properties.readonlyField.additionalProperties = true; })],
+    ['nested optional property', primitives, mutate(value => { value.properties.readonlyField.required = ['owner']; })],
+    ['nested reference', primitives, mutate(value => { value.properties.readonlyField.properties.owner = {$ref: '#/owner'}; })],
+    ['nested union', primitives, mutate(value => { value.properties.readonlyField.properties.owner = {anyOf: [{type: 'string'}]}; })],
+    ['invalid pattern', primitives, mutate(value => { value.properties.readonlyField.properties.owner.pattern = '['; })],
+    ['invalid length', primitives, mutate(value => { value.properties.readonlyField.properties.owner.maxLength = -1; })],
+  ];
+  for (const [name, before, after] of cases) {
+    const result = checkContractChange({before: {[path]: before}, after: {[path]: after},
+      beforeVersions: versions, afterVersions: versions});
+    assert.equal(result.changes[0].breaking, true, name);
+    assert.equal(result.errors.length, 2, name);
+  }
+});
+
+test('uniform item proof retains array constraints and rejects tuple or boolean-item changes', () => {
+  const path = 'planning/contracts/schema/bytecode-image.v2.schema.json';
+  const primitives = {type: ['number', 'boolean', 'string', 'null']};
+  const carrier = JSON.parse(readFileSync(new URL('../schema/bytecode-image.v2.schema.json', import.meta.url), 'utf8'))
+    .properties.constants.items;
+  const before = {type: 'array', items: primitives, maxItems: 1000000};
+  for (const [name, input, after] of [
+    ['narrower array bound', before, {...before, items: carrier, maxItems: 999999}],
+    ['new uniqueness constraint', before, {...before, items: carrier, uniqueItems: true}],
+    ['tuple output', before, {...before, items: [carrier]}],
+    ['tuple input', {...before, items: [primitives]}, {...before, items: carrier}],
+    ['boolean input', {...before, items: true}, {...before, items: carrier}],
+    ['boolean output', before, {...before, items: true}],
+    ['missing explicit array type', {items: primitives}, {items: carrier}],
+  ]) {
+    const result = checkContractChange({before: {[path]: input}, after: {[path]: after},
+      beforeVersions: versions, afterVersions: versions});
+    assert.equal(result.changes[0].breaking, true, name);
+    assert.equal(result.errors.length, 2, name);
+  }
+});
+
+test('carrier item widening cannot hide a narrowing referenced oneOf elsewhere in the schema', () => {
+  const path = 'planning/contracts/schema/bytecode-image.v2.schema.json';
+  const primitives = {type: ['number', 'boolean', 'string', 'null']};
+  const carrier = JSON.parse(readFileSync(new URL('../schema/bytecode-image.v2.schema.json', import.meta.url), 'utf8'))
+    .properties.constants.items;
+  const before = {type: 'object', properties: {
+    constants: {type: 'array', items: primitives},
+    payload: {oneOf: [{$ref: '#/properties/constants/items'}, {type: 'object'}]},
+  }, required: ['constants', 'payload'], additionalProperties: false};
+  const after = structuredClone(before);
+  after.properties.constants.items = carrier;
+  const document = {constants: [], payload: {readonlyField: {owner: 'System.Boolean', name: 'TrueString'}}};
+  assert.equal(validate(before, document), document);
+  assert.throws(() => validate(after, document), {code: 'SCHEMA_INVALID'});
+  const result = checkContractChange({before: {[path]: before}, after: {[path]: after},
+    beforeVersions: versions, afterVersions: versions});
+  assert.equal(result.changes[0].breaking, true);
+  assert.equal(result.errors.length, 2);
+});
+
+test('new carrier proofs conservatively reject reference and scope contexts outside the changed item', () => {
+  const path = 'planning/contracts/schema/bytecode-image.v2.schema.json';
+  const primitives = {type: ['number', 'boolean', 'string', 'null']};
+  const carrier = JSON.parse(readFileSync(new URL('../schema/bytecode-image.v2.schema.json', import.meta.url), 'utf8'))
+    .properties.constants.items;
+  for (const keyword of ['$ref', '$dynamicRef', '$recursiveRef', '$id', '$anchor', '$dynamicAnchor', '$recursiveAnchor']) {
+    const before = {type: 'object', properties: {constants: {type: 'array', items: primitives},
+      unrelated: {[keyword]: '#/properties/constants/items'}}, additionalProperties: false};
+    const after = structuredClone(before); after.properties.constants.items = carrier;
+    const result = checkContractChange({before: {[path]: before}, after: {[path]: after},
+      beforeVersions: versions, afterVersions: versions});
+    assert.equal(result.changes[0].breaking, true, keyword);
+    assert.equal(result.errors.length, 2, keyword);
+  }
+});
