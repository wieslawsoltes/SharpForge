+// A widened subschema can narrow an unchanged oneOf reached through a reference.
+// New carrier/items rules are enabled only for a reference-free whole schema.
+function schemaReferenceContext(schema) {
+  const pending = [schema], seen = new Set();
+  const scopeKeys = new Set(['$ref', '$dynamicRef', '$recursiveRef', '$id', '$anchor', '$dynamicAnchor', '$recursiveAnchor']);
+  while (pending.length) {
+    const value = pending.pop();
+    if (!value || typeof value !== 'object') continue;
+    if (seen.has(value)) return true;
+    seen.add(value);
+    if (Object.keys(value).some(key => scopeKeys.has(key))) return true;
+    for (const child of Object.values(value)) pending.push(child);
+  }
+  return false;
+}
+
+// This proof adds only a closed inline string-record alternative. Object-only
+// keywords cannot constrain any previously admitted primitive, and no union
+// traversal is introduced on the primitive validation path.
+function closedStringRecord(schema, annotations, depth = 0) {
+  if (!schema || typeof schema !== 'object' || Array.isArray(schema) || depth >= 8) return false;
+  if (schema.type !== 'object' || schema.additionalProperties !== false ||
+      !Object.keys(schema).every(key => ['type', 'properties', 'required', 'additionalProperties'].includes(key) ||
+        annotations.has(key))) return false;
+  const properties = schema.properties;
+  if (!properties || typeof properties !== 'object' || Array.isArray(properties)) return false;
+  const names = Object.keys(properties), required = schema.required;
+  if (!names.length || !Array.isArray(required) || required.length !== names.length ||
+      new Set(required).size !== required.length ||
+      required.some(name => typeof name !== 'string' || !Object.hasOwn(properties, name))) return false;
+  return Object.values(properties).every(property => {
+    if (!property || typeof property !== 'object' || Array.isArray(property)) return false;
+    if (property.type === 'object') return closedStringRecord(property, annotations, depth + 1);
+    if (property.type !== 'string' || !Object.keys(property).every(key =>
+      ['type', 'minLength', 'maxLength', 'pattern'].includes(key) || annotations.has(key))) return false;
+    for (const key of ['minLength', 'maxLength']) {
+      if (Object.hasOwn(property, key) && (!Number.isSafeInteger(property[key]) || property[key] < 0)) return false;
+    }
+    if (property.maxLength !== undefined && (property.minLength ?? 0) > property.maxLength) return false;
+    if (Object.hasOwn(property, 'pattern')) {
+      if (typeof property.pattern !== 'string') return false;
+      try { new RegExp(property.pattern, 'u'); } catch { return false; }
+    }
+    return true;
+  });
+}
+
+function additiveClosedObjectCarrier(before, after, annotations) {
+  const types = before.type;
+  if (!Array.isArray(types) || !types.length || new Set(types).size !== types.length ||
+      !types.every(type => ['number', 'integer', 'boolean', 'string', 'null'].includes(type)) ||
+      !Object.keys(before).every(key => key === 'type' || annotations.has(key)) ||
+      !isDeepStrictEqual(after.type, [...types, 'object'])) return false;
+  return closedStringRecord({...after, type: 'object'}, annotations);
+}
+
 // A deliberately conservative schema proof: unknown validation keywords and
 // conjunction/exclusive-union extensions may narrow acceptance and need a bump.
 export function additiveSchema(before,after) {
+  const carrierContext=!schemaReferenceContext(before)&&!schemaReferenceContext(after);
+  return additiveSchemaInContext(before,after,carrierContext);
+}
+
+function additiveSchemaInContext(before,after,carrierContext) {
   if(isDeepStrictEqual(before,after))return true;
   if(before===false)return true;
   if(!before||!after||typeof before!=='object'||typeof after!=='object'||Array.isArray(before)||Array.isArray(after))return false;
   const annotation=new Set(['title','description','$comment','examples']);
   if(additiveStringPatternUnion(before,after,annotation))return true;
+  if(carrierContext&&additiveClosedObjectCarrier(before,after,annotation))return true;
   for(const [name,value] of Object.entries(before)){
     if(annotation.has(name))continue;
     if(!Object.hasOwn(after,name))return false;
     if(isDeepStrictEqual(value,after[name]))continue;
     if(name==='required') {if(!Array.isArray(after[name])||!after[name].every(v=>value.includes(v)))return false;}
     else if(name==='enum'||name==='anyOf') {if(!Array.isArray(after[name])||!value.every(v=>after[name].some(w=>isDeepStrictEqual(v,w))))return false;}
+    else if(name==='items') {
+      if(!carrierContext||before.type!=='array'||after.type!=='array'||!value||typeof value!=='object'||Array.isArray(value)||
+        !after.items||typeof after.items!=='object'||Array.isArray(after.items)||
+        !additiveSchemaInContext(value,after.items,carrierContext))return false;
+    }
     else if(name==='properties'||name==='$defs') {
       if(!after[name]||typeof after[name]!=='object'||Array.isArray(after[name]))return false;
-      if(!Object.keys(value).every(k=>Object.hasOwn(after[name],k)&&additiveSchema(value[k],after[name][k])))return false;
+      if(!Object.keys(value).every(k=>Object.hasOwn(after[name],k)&&additiveSchemaInContext(value[k],after[name][k],carrierContext)))return false;
       if(name==='properties'&&before.additionalProperties!==false&&Object.keys(after[name]).some(k=>!Object.hasOwn(value,k)))return false;
     }else return false;
   }
