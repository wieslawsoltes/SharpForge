{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "blockers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blockers": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "taskIds",
          "scenarios",
          "targets",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]+$"
          },
          "taskIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(SF-A[0-9]{2}-[TB][0-9]{2}(\\.[0-9]+)?|GAP-[A-Z0-9-]+)$"
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "cli",
                "studio",
                "node"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
