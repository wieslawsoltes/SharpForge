{
  "schemaVersion": 1,
  "id": "solution-edit-build-debug",
  "targets": [
    "cli",
    "studio"
  ],
  "timeoutMs": 30000,
  "steps": [
    {
      "id": "open",
      "action": "open",
      "fixture": "solution",
      "entry": "Acceptance.slnx",
      "startup": "App/App.csproj"
    },
    {
      "id": "edit",
      "action": "edit",
      "path": "Core/Service.cs",
      "find": "Add(20, 22)",
      "replace": "Add(20, 23)"
    },
    {
      "id": "build",
      "action": "build"
    },
    {
      "id": "breakpoints",
      "action": "breakpoints",
      "points": [
        {
          "path": "Math/Arithmetic.cs",
          "line": 6
        },
        {
          "path": "Core/Service.cs",
          "line": 6
        },
        {
          "path": "App/Program.cs",
          "line": 6
        }
      ]
    },
    {
      "id": "debug",
      "action": "debug",
      "path": "Math/Arithmetic.cs",
      "line": 6
    },
    {
      "id": "inspect-math",
      "action": "inspect",
      "expression": "sum",
      "equals": "43"
    },
    {
      "id": "step-out",
      "action": "step",
      "kind": "stepOut",
      "path": "Core/Service.cs",
      "line": 6
    },
    {
      "id": "inspect-core",
      "action": "inspect",
      "expression": "answer",
      "equals": "43"
    },
    {
      "id": "continue-app",
      "action": "continue",
      "path": "App/Program.cs",
      "line": 6
    },
    {
      "id": "inspect-app",
      "action": "inspect",
      "expression": "answer",
      "equals": "43"
    },
    {
      "id": "finish",
      "action": "continue",
      "output": "43"
    }
  ]
}
