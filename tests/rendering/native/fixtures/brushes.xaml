      <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="24,24" SpreadMethod="Repeat">
        <GradientStop Offset="0" Color="#FFB53D35" /><GradientStop Offset="1" Color="#FFEFBC43" />
      </LinearGradientBrush>
    </Ellipse.Fill>
  </Ellipse>
</Canvas>
