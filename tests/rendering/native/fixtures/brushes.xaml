      <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,0.4" SpreadMethod="Reflect">
        <GradientStop Offset="0" Color="#FF164499" /><GradientStop Offset="0.5" Color="#AA66AA55" />
        <GradientStop Offset="1" Color="#008833AA" />
