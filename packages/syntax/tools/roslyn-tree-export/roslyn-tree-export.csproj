<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps Roslyn syntax trees and token streams as JSON reference data for the SharpForge syntax tests.
       It compiles against the Roslyn assemblies that ship inside the .NET SDK, so no NuGet package is restored. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RoslynDirectory>$(MSBuildToolsPath)/Roslyn/bincore</RoslynDirectory>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynDirectory)/Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynDirectory)/Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
  </ItemGroup>
</Project>
