<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roslyn pinning tool for the reference-manager fixtures (SF-A02-T22). Built by generate.mjs in a scratch directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>references</AssemblyName>
    <RootNamespace>SharpForge.References</RootNamespace>
    <RoslynDir Condition="'$(RoslynDir)' == ''">$(MSBuildToolsPath)/Roslyn/bincore</RoslynDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
