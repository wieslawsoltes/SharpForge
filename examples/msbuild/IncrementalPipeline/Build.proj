<Project DefaultTargets="Build" InitialTargets="CheckRoot">
  <Import Project="Pipeline.props" />
  <Import Project="Inline.targets" />
  <ItemDefinitionGroup><Input><Category>example</Category></Input></ItemDefinitionGroup>
  <ItemGroup><Input Include="inputs/*.txt" /></ItemGroup>
  <Target Name="CheckRoot"><Error Condition="'$(OutputDirectory)' == ''" Text="Missing output directory" /></Target>
  <Target Name="Prepare"><MakeDir Directories="$(OutputDirectory)" /></Target>
  <Target Name="Transform" DependsOnTargets="Prepare" Inputs="@(Input)" Outputs="@(Input->'$(OutputDirectory)/%(Filename).copy.txt')">
    <Copy SourceFiles="@(Input)" DestinationFiles="@(Input->'$(OutputDirectory)/%(Filename).copy.txt')" />
    <Message Text="Transformed %(Input.Identity) [%(Input.Category)]" Importance="High" />
  </Target>
  <Target Name="Build" DependsOnTargets="Transform" Returns="@(OutputFile)">
    <ItemGroup><OutputFile Include="$(OutputDirectory)/*.copy.txt" /></ItemGroup>
    <Message Importance="High" Text="Native target graph completed: @(OutputFile)" />
  </Target>
  <Target Name="Clean"><RemoveDir Directories="$(OutputDirectory)" /></Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
  <Target Name="Diagnose">
    <Warning Code="SFBUILD001" File="Build.proj" Text="An intentional warning for the IDE error list." />
    <Error Code="SFBUILD002" File="Build.proj" Text="An intentional error for the IDE error list." />
    <OnError ExecuteTargets="AfterFailure" />
  </Target>
  <Target Name="AfterFailure"><Message Text="OnError ran" Importance="High" /></Target>
</Project>
